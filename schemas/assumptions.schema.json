{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akshat4112.github.io/immopilot-de/schemas/assumptions.schema.json",
  "title": "ImmoPilot DE versioned assumption set",
  "description": "Schema for an immutable, source-backed German-market assumption set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "documentType",
    "schemaVersion",
    "assumptionSetVersion",
    "calculationSpecificationVersion",
    "jurisdiction",
    "currency",
    "effectiveFrom",
    "verifiedOn",
    "acquisitionDefaults",
    "transferTax",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documentType": {
      "const": "assumption-set"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "assumptionSetVersion": {
      "$ref": "#/$defs/assumptionSetVersion"
    },
    "calculationSpecificationVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "jurisdiction": {
      "const": "DE"
    },
    "currency": {
      "const": "EUR"
    },
    "effectiveFrom": {
      "$ref": "#/$defs/isoDate"
    },
    "verifiedOn": {
      "$ref": "#/$defs/isoDate"
    },
    "acquisitionDefaults": {
      "$ref": "#/$defs/acquisitionDefaults"
    },
    "transferTax": {
      "$ref": "#/$defs/transferTax"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "assumptionSetVersion": {
      "type": "string",
      "pattern": "^de-[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "moneyCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceId"
      }
    },
    "rateDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "classification",
        "editable",
        "vatTreatment",
        "sourceIds"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/rate"
        },
        "classification": {
          "enum": [
            "statutory-rate",
            "planning-proxy",
            "contract-specific-rate"
          ]
        },
        "editable": {
          "const": true
        },
        "vatTreatment": {
          "enum": [
            "included-in-default",
            "not-added",
            "not-applicable"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "budgetDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountCents",
        "budgetStatus",
        "classification",
        "editable",
        "sourceIds"
      ],
      "properties": {
        "amountCents": {
          "$ref": "#/$defs/moneyCents"
        },
        "budgetStatus": {
          "enum": [
            "not-budgeted",
            "confirmed-zero",
            "budgeted"
          ]
        },
        "classification": {
          "const": "user-specific-amount"
        },
        "editable": {
          "const": true
        },
        "timeScope": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "budgetStatus": {
                "enum": [
                  "not-budgeted",
                  "confirmed-zero"
                ]
              }
            },
            "required": [
              "budgetStatus"
            ]
          },
          "then": {
            "properties": {
              "amountCents": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "budgetStatus": {
                "const": "budgeted"
              }
            },
            "required": [
              "budgetStatus"
            ]
          },
          "then": {
            "properties": {
              "amountCents": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "brokerDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "involved",
        "buyerCommissionRate",
        "splitRule"
      ],
      "properties": {
        "involved": {
          "const": false
        },
        "buyerCommissionRate": {
          "$ref": "#/$defs/rateDefault"
        },
        "splitRule": {
          "const": "contract-controls"
        }
      }
    },
    "acquisitionDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notaryRate",
        "landRegisterRate",
        "broker",
        "renovationBudget",
        "movingSetupCosts"
      ],
      "properties": {
        "notaryRate": {
          "$ref": "#/$defs/rateDefault"
        },
        "landRegisterRate": {
          "$ref": "#/$defs/rateDefault"
        },
        "broker": {
          "$ref": "#/$defs/brokerDefaults"
        },
        "renovationBudget": {
          "$ref": "#/$defs/budgetDefault"
        },
        "movingSetupCosts": {
          "$ref": "#/$defs/budgetDefault"
        }
      }
    },
    "stateTaxRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nameDe",
        "nameEn",
        "rate",
        "effectiveFrom"
      ],
      "properties": {
        "id": {
          "enum": [
            "DE-BW",
            "DE-BY",
            "DE-BE",
            "DE-BB",
            "DE-HB",
            "DE-HH",
            "DE-HE",
            "DE-MV",
            "DE-NI",
            "DE-NW",
            "DE-RP",
            "DE-SL",
            "DE-SN",
            "DE-ST",
            "DE-SH",
            "DE-TH"
          ]
        },
        "nameDe": {
          "type": "string",
          "minLength": 1
        },
        "nameEn": {
          "type": "string",
          "minLength": 1
        },
        "rate": {
          "$ref": "#/$defs/rate"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/isoDate"
        }
      }
    },
    "transferTax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "taxableBasis",
        "editable",
        "rateSourceDate",
        "sourceIds",
        "states"
      ],
      "properties": {
        "classification": {
          "const": "statutory-rate"
        },
        "taxableBasis": {
          "const": "purchase-price"
        },
        "editable": {
          "const": true
        },
        "rateSourceDate": {
          "$ref": "#/$defs/isoDate"
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "states": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stateTaxRate"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "title",
        "url",
        "authorityType",
        "sourceDate",
        "verifiedOn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "authorityType": {
          "enum": [
            "statute",
            "official-professional-guidance",
            "consumer-guidance"
          ]
        },
        "sourceDate": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiedOn": {
          "$ref": "#/$defs/isoDate"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
